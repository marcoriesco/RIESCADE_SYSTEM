{
  "name": "RIESCADE Default",
  "version": "2.7.2",
  "author": "Marco Riesco",
  "description": "Tema padrão do RIESCADE Frontend (JS/HTML/CSS)",
  "templates": {
    "system": {
      "optionId": "system_type",
      "carousel": "system_carousel.html",
      "grid": "system_grid.html",
      "default": "system_carousel.html"
    },
    "gamelist": "gamelist.html",
    "start": "start.html",
    "loading": "loading.html"
  },
  "options": [
    {
      "id": "geral_group",
      "name": "OPÇÕES GERAIS",
      "type": "group"
    },
    {
      "id": "colors",
      "name": "COLOR HIGHLIGHTS",
      "type": "select",
      "options": [
        {
          "value": "#9f0043",
          "label": "PINK"
        },
        {
          "value": "#ffffff",
          "label": "WHITE"
        },
        {
          "value": "#3377ff",
          "label": "BLUE"
        },
        {
          "value": "#13eafd",
          "label": "LIGHT BLUE"
        },
        {
          "value": "#fb2246",
          "label": "RED"
        },
        {
          "value": "#cccccc",
          "label": "GRAY"
        },
        {
          "value": "#00ffbf",
          "label": "GREEN"
        },
        {
          "value": "#9133c7",
          "label": "PURPLE"
        },
        {
          "value": "#ffc233",
          "label": "YELLOW"
        }
      ],
      "default": "9f0043"
    },
    {
      "id": "controller",
      "name": "Controller Icon",
      "type": "select",
      "options": [
        {
          "value": "ps4",
          "label": "PS4"
        },
        {
          "value": "xbox",
          "label": "XBOX"
        },
        {
          "value": "switch",
          "label": "SWITCH"
        },
        {
          "value": "arcade",
          "label": "ARCADE"
        }
      ],
      "default": "ps4"
    },
    {
      "id": "system_group",
      "name": "OPÇÕES DA SYSTEM",
      "type": "group"
    },
    {
      "id": "system_type",
      "name": "Tipo de navegação",
      "type": "select",
      "options": [
        {
          "value": "carousel",
          "label": "CAROUSEL"
        },
        {
          "value": "grid",
          "label": "GRID"
        }
      ],
      "default": "carousel"
    },
    {
      "id": "system_video",
      "name": "VÍDEO GAMEPLAY",
      "type": "toggle",
      "default": true
    },
    {
      "id": "system_video_delay",
      "name": "VIDEO ATRASO",
      "type": "select",
      "options": [
        {
          "value": "0",
          "label": "NENHUM"
        },
        {
          "value": "2",
          "label": "2 segundos"
        },
        {
          "value": "3",
          "label": "3 segundos"
        },
        {
          "value": "4",
          "label": "4 segundos"
        },
        {
          "value": "5",
          "label": "5 segundos"
        },
        {
          "value": "10",
          "label": "10 segundos"
        }
      ],
      "default": "3"
    },
    {
      "id": "gamelist_group",
      "name": "OPÇÕES DA GAMELIST",
      "type": "group"
    },
    {
      "id": "gamelist_type",
      "name": "Tipo de navegação",
      "type": "select",
      "options": [
        {
          "value": "carousel",
          "label": "CAROUSEL"
        },
        {
          "value": "grid",
          "label": "GRID"
        }
      ],
      "default": "carousel"
    },
    {
      "id": "gamelist_video",
      "name": "VÍDEO GAMEPLAY",
      "type": "toggle",
      "default": true
    },
    {
      "id": "gamelist_video_delay",
      "name": "VIDEO ATRASO",
      "type": "select",
      "options": [
        {
          "value": "0",
          "label": "NENHUM"
        },
        {
          "value": "2",
          "label": "2 segundos"
        },
        {
          "value": "3",
          "label": "3 segundos"
        },
        {
          "value": "4",
          "label": "4 segundos"
        },
        {
          "value": "5",
          "label": "5 segundos"
        },
        {
          "value": "10",
          "label": "10 segundos"
        }
      ],
      "default": "3"
    }
  ]
}
