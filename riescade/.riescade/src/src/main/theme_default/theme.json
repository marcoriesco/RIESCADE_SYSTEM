{
  "name": "RIESCADE Default",
  "version": "2.7.2",
  "author": "Marco Riesco",
  "description": "Tema padrão do RIESCADE Frontend (JS/HTML/CSS)",
  "templates": {
    "system": {
      "optionId": "system_type",
      "carousel": "system_carousel.html",
      "grid": "system_grid.html",
      "default": "system_carousel.html"
    },
    "gamelist": "gamelist.html",
    "start": "start.html",
    "loading": "loading.html"
  },
  "options": [
    {
      "id": "colors",
      "name": "COLOR HIGHLIGHTS",
      "type": "select",
      "options": [
        {
          "value": "#9f0043",
          "label": "PINK"
        },
        {
          "value": "#ffffff",
          "label": "WHITE"
        },
        {
          "value": "#3377ff",
          "label": "BLUE"
        },
        {
          "value": "#13eafd",
          "label": "LIGHT BLUE"
        },
        {
          "value": "#fb2246",
          "label": "RED"
        },
        {
          "value": "#cccccc",
          "label": "GRAY"
        },
        {
          "value": "#00ffbf",
          "label": "GREEN"
        },
        {
          "value": "#9133c7",
          "label": "PURPLE"
        },
        {
          "value": "#ffc233",
          "label": "YELLOW"
        }
      ],
      "default": "9f0043"
    },
    {
      "id": "controller",
      "name": "Controller Icon",
      "type": "select",
      "options": [
        {
          "value": "ps4",
          "label": "PS4"
        },
        {
          "value": "xbox",
          "label": "XBOX"
        },
        {
          "value": "switch",
          "label": "SWITCH"
        },
        {
          "value": "arcade",
          "label": "ARCADE"
        }
      ],
      "default": "ps4"
    },
    {
      "id": "system_type",
      "name": "Mostrar sistemas",
      "type": "select",
      "options": [
        {
          "value": "carousel",
          "label": "CAROUSEL"
        },
        {
          "value": "grid",
          "label": "GRID"
        }
      ],
      "default": "carousel"
    }
  ]
}
